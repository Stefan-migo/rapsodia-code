#!/usr/bin/env bash
# Rapsodia pre-commit hook — Atomicity Gate + GGA Guardian
set -euo pipefail

# === Step 1: Atomicity Gate (≤5 files) ===
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACDMR | wc -l)
if [ "$CHANGED_FILES" -gt 5 ]; then
  echo "❌ Atomicity Gate: $CHANGED_FILES files staged (max 5)"
  echo "   Split your changes into multiple commits (one concern each)"
  exit 1
fi

# === Step 1b: Main worktree guard ===
# ACDMR, not ACMR: a staged DELETION of tracked code must be rejected too.
# With ACMR a deletion lists no paths, the loop below never iterates, and the
# commit passes — the guard silently allowed removing code from main.
#
# The line drawn below is product vs. local regenerable state, not code vs. non-code. A
# code-only reading refuses the output of the product's own close flow: `rapso close`
# writes its Engram snapshot into `wiki/` (see engine/session.ts), those files are tracked,
# and the old single-pattern allowlist rejected them in the main worktree.
#
# Two properties worth knowing before trusting this as more than it is. The check is
# directory-based, not branch-based: it compares --git-dir against --git-common-dir, which
# are equal only in the main worktree, so a feature branch created inside the main
# directory does not evade it and a linked worktree is not subject to it at all. And it is
# a local convenience, not an integrity gate — `main` carries no branch protection, no CI
# runs on it, and `--no-verify` bypasses this file entirely.
GIT_DIR=$(git rev-parse --git-dir)
COMMON_DIR=$(git rev-parse --git-common-dir)
if [ "$GIT_DIR" = "$COMMON_DIR" ] && ! git diff --cached --quiet; then
  while IFS= read -r path; do
    case "$path" in
      .rapsodia-code/*|wiki/*|.atl/*) ;;
      *) echo "Main worktree guard: direct commits are only allowed for local regenerable state (.rapsodia-code/**, wiki/**, .atl/**)"; exit 1 ;;
    esac
  done < <(git diff --cached --name-only --diff-filter=ACDMR)
fi

# === Step 2: File type diversity warning ===
FILE_TYPES=$(git diff --cached --name-only --diff-filter=ACDMR | awk -F. '{if(NF>1) print $NF}' | sort -u | wc -l)
if [ "$FILE_TYPES" -gt 3 ]; then
  echo "⚠️  Warning: $FILE_TYPES different file types in this commit"
  echo "   Consider splitting into focused commits"
fi

# The review session `gga` starts snapshots the workspace through its own git dir:
#   git --git-dir <snapshot> --work-tree <repo> add --all --sparse ...
# git exports GIT_INDEX_FILE to every hook it runs, so that write lands in THIS repository's
# index and stages the whole working tree — including untracked files, and after the
# Atomicity Gate above has already read the index it is supposed to gate. Unsetting it lets
# the snapshot use its own index while every git call below resolves the default one, which
# is the same index git passed in. This stays outside the managed block so `gga install`
# cannot drop it.
unset GIT_INDEX_FILE

# ======== GGA START ========
# Gentleman Guardian Angel - Code Review
gga run || exit 1
# ======== GGA END ========
